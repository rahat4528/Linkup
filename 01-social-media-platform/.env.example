# Application Environment Configuration
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:3000

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://linkup_user:linkup_secure_password@localhost:5432/linkup_social_media_db?schema=public

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=linkup-social-media
S3_FORCE_PATH_STYLE=true
