# Application Configuration
NODE_ENV=development
PORT=4002
FRONTEND_URL=http://localhost:3001

# Security
JWT_SECRET=linkup_instagram_secret_jwt_key_min_32_chars_123
JWT_EXPIRES_IN=1d

# Database Connection (Dedicated for App 02)
DATABASE_URL=postgresql://linkup_user:linkup_secure_password@localhost:5433/linkup_instagram_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=linkup-instagram-media
S3_FORCE_PATH_STYLE=true
