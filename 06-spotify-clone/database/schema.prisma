datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  username     String           @unique
  passwordHash String
  name         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  playlists    Playlist[]
  likedTracks  UserLikedTrack[]
  savedAlbums  UserSavedAlbum[]

  @@map("users")
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  albums    Album[]
  tracks    Track[]

  @@map("artists")
}

model Album {
  id          String           @id @default(uuid())
  artistId    String
  title       String
  coverUrl    String?
  releaseYear Int              @default(2026)
  createdAt   DateTime         @default(now())

  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]
  savedBy     UserSavedAlbum[]

  @@map("albums")
}

model Track {
  id          String           @id @default(uuid())
  albumId     String?
  artistId    String
  title       String
  durationMs  Int              @default(180000)
  audioUrl    String
  trackNumber Int              @default(1)
  createdAt   DateTime         @default(now())

  album       Album?           @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  playlists   PlaylistTrack[]
  likedBy     UserLikedTrack[]

  @@map("tracks")
}

model Playlist {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
  @@map("playlist_tracks")
}

model UserLikedTrack {
  id      String   @id @default(uuid())
  userId  String
  trackId String
  likedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("user_liked_tracks")
}

model UserSavedAlbum {
  id      String   @id @default(uuid())
  userId  String
  albumId String
  savedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@map("user_saved_albums")
}
