datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ParticipantRole {
  HOST
  COHOST
  PARTICIPANT
}

enum ParticipantStatus {
  WAITING
  ADMITTED
  LEFT
  EXPELLED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  hostedRooms  Room[]        @relation("HostedRooms")
  participants Participant[]
  chatMessages ChatMessage[]

  @@map("users")
}

model Room {
  id                 String         @id @default(uuid())
  roomCode           String         @unique
  title              String
  description        String?
  hostId             String
  isLocked           Boolean        @default(false)
  waitingRoomEnabled Boolean        @default(false)
  maxParticipants    Int            @default(100)
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  host               User           @relation("HostedRooms", fields: [hostId], references: [id], onDelete: Cascade)
  participants       Participant[]
  chatMessages       ChatMessage[]
  recordings         MeetingRecording[]

  @@index([roomCode])
  @@index([hostId])
  @@map("rooms")
}

model Participant {
  id              String            @id @default(uuid())
  roomId          String
  userId          String?
  peerId          String            @unique
  displayName     String
  role            ParticipantRole   @default(PARTICIPANT)
  status          ParticipantStatus @default(ADMITTED)
  isMuted         Boolean           @default(false)
  isVideoOff      Boolean           @default(false)
  isHandRaised    Boolean           @default(false)
  isScreenSharing Boolean           @default(false)
  joinedAt        DateTime          @default(now())
  leftAt          DateTime?

  room            Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([userId])
  @@map("participants")
}

model ChatMessage {
  id          String   @id @default(uuid())
  roomId      String
  senderId    String?
  senderName  String
  content     String
  isDirect    Boolean  @default(false)
  recipientId String?
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@map("chat_messages")
}

model MeetingRecording {
  id              String   @id @default(uuid())
  roomId          String
  durationSeconds Float
  fileSize        Int
  fileUrl         String
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())

  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("meeting_recordings")
}
