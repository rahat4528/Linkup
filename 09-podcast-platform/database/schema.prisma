datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EpisodeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  username         String             @unique
  displayName      String
  passwordHash     String
  avatarUrl        String?
  role             String             @default("CREATOR")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  podcasts         Podcast[]          @relation("CreatorPodcasts")
  subscriptions    Subscription[]
  listeningHistory ListeningHistory[]

  @@map("users")
}

model Podcast {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String
  author        String
  coverUrl      String
  category      String         @default("Technology")
  language      String         @default("en")
  explicit      Boolean        @default(false)
  websiteUrl    String?
  creatorId     String
  creator       User           @relation("CreatorPodcasts", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  episodes      Episode[]
  subscriptions Subscription[]

  @@index([slug])
  @@index([category])
  @@index([creatorId])
  @@map("podcasts")
}

model Episode {
  id              String             @id @default(uuid())
  podcastId       String
  title           String
  description     String
  episodeNumber   Int?
  seasonNumber    Int?               @default(1)
  audioUrl        String
  durationSeconds Float
  fileSize        Int
  mimeType        String             @default("audio/mpeg")
  status          EpisodeStatus      @default(PUBLISHED)
  explicit        Boolean            @default(false)
  playCount       Int                @default(0)
  publishedAt     DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  podcast         Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  listeningHistory ListeningHistory[]

  @@index([podcastId])
  @@index([status])
  @@map("episodes")
}

model Chapter {
  id               String   @id @default(uuid())
  episodeId        String
  title            String
  startTimeSeconds Float
  endTimeSeconds   Float?
  url              String?
  createdAt        DateTime @default(now())

  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@map("chapters")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId])
  @@map("subscriptions")
}

model ListeningHistory {
  id              String   @id @default(uuid())
  userId          String
  episodeId       String
  progressSeconds Float    @default(0.0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@map("listening_history")
}
